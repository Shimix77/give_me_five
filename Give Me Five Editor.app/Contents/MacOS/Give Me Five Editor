#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"
APP_URL="http://127.0.0.1:4173"
EXPECTED_VERSION="$(/usr/bin/sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$PROJECT_DIR/package.json")"
RUNNING_HEALTH="$(/usr/bin/curl -fsS "$APP_URL/api/health" 2>/dev/null || true)"
RUNNING_VERSION="$(/usr/bin/printf '%s' "$RUNNING_HEALTH" | /usr/bin/sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"

if [ -n "$RUNNING_HEALTH" ] && [ "$RUNNING_VERSION" = "$EXPECTED_VERSION" ]; then
  /usr/bin/open -b com.google.Chrome "$APP_URL" >/dev/null 2>&1 || /usr/bin/open "$APP_URL"
  exit 0
fi

# LaunchServices otvorí .command priamo v Termináli. Na rozdiel od AppleScriptu
# to nevyžaduje povolenie „ovládať Terminal“ a Terminal má prístup k Dokumentom.
/usr/bin/open -a Terminal "$PROJECT_DIR/start.command"
exit 0
