# Doména musí A/AAAA záznamom smerovať na verejnú IP Oracle VM.
GMF_DOMAIN=video.example.sk

# Samostatné údaje iba pre cloud. Nepoužívajte heslo z inej služby.
GMF_ACCESS_USER=give-me-five
GMF_ACCESS_KEY=SEM_VLOZTE_DLHE_NAHODNE_HESLO_MIN_32_ZNAKOV

# Limity cloudovej inštancie. Lokálne spúšťanie ich nepoužíva.
GMF_MAX_UPLOAD_MB=300
GMF_MIN_FREE_DISK_MB=512
GMF_SESSION_TMPFS_SIZE=2g
